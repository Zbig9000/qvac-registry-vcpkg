{
  "name": "dawn",
  "version": "20260410.140140",
  "description": "Dawn is an open-source and cross-platform implementation of the WebGPU standard. QVAC registry copy of the official port at the version the speech-branch ggml-webgpu compiles against (the official 20260911 port changed the uncaptured-error callback API); Linux default features trimmed to vulkan so a build host needs no X11 development headers.",
  "homepage": "https://dawn.googlesource.com/dawn",
  "license": "BSD-3-Clause",
  "dependencies": [
    {
      "name": "abseil",
      "platform": "!emscripten"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "vcpkg-get-python-packages",
      "host": true
    }
  ],
  "default-features": [
    {
      "name": "metal",
      "platform": "osx | ios"
    },
    {
      "name": "vulkan",
      "platform": "(windows & !uwp) | android | linux"
    }
  ],
  "features": {
    "d3d11": {
      "description": "Direct3D 11 backend support",
      "supports": "windows",
      "dependencies": [
        "directx-dxc"
      ]
    },
    "d3d12": {
      "description": "Direct3D 12 backend support",
      "supports": "windows",
      "dependencies": [
        "directx-dxc"
      ]
    },
    "gl": {
      "description": "Desktop OpenGL backend support",
      "supports": "linux | freebsd | openbsd",
      "dependencies": [
        "egl-registry",
        "opengl-registry"
      ]
    },
    "gles": {
      "description": "OpenGL ES backend support",
      "supports": "android | linux | freebsd | openbsd",
      "dependencies": [
        "egl-registry",
        "opengl-registry"
      ]
    },
    "metal": {
      "description": "Metal backend support",
      "supports": "osx | ios"
    },
    "tint-tools": {
      "description": "Build tint command-line tools",
      "supports": "(windows & !uwp) | linux | freebsd | openbsd | osx",
      "dependencies": [
        "glslang"
      ]
    },
    "vulkan": {
      "description": "Vulkan backend support",
      "supports": "(windows & !uwp) | android | linux | freebsd | openbsd",
      "dependencies": [
        "vulkan-headers",
        "vulkan-utility-libraries"
      ]
    },
    "wayland": {
      "description": "Wayland support",
      "supports": "linux | freebsd | openbsd"
    },
    "x11": {
      "description": "X11 support",
      "supports": "linux | freebsd | openbsd"
    }
  },
  "port-version": 1
}
